namespace app.store

import arm092.migrations.Migrator
import sql "go:database/sql"
import _ "go:modernc.org/sqlite"

type Task struct {
	ID int64
	Title string
}

class Store {
	private db * sql.DB
	constructor(path string, migrations string = "") {
		this.db = sql.Open("sqlite", path)
		this.db.SetMaxOpenConns(1)
		try {
			if migrations == "" {
				migrations = MigrationDirectory()
			}
			migrator := new Migrator(this.db, migrations)
			migrator.Up()
		} catch err Exception {
			this.db.Close()
			throw err
		}
	}
	public func Close() {
		this.db.Close()
	}
	public func Add(title string) Task {
		result := this.db.Exec("INSERT INTO tasks(title) VALUES (?)", title)
		id := result.LastInsertId()

		return Task{
			ID: id,
			Title: title,
		}
	}
	public func List() []Task {
		rows := this.db.Query("SELECT id, title FROM tasks ORDER BY id")
		defer rows.Close()
		tasks := []Task{}
		for rows.Next() {
			var task Task
			rows.Scan(&task.ID, &task.Title)
			tasks = append(tasks, task)
		}
		rows.Err()

		return tasks
	}
}
