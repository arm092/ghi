namespace infrastructure.sqlite
import context "go:context"
import sql "go:database/sql"
import errors "go:errors"
import user "domain.user"

class UserRepository implements user.Repository {
	private db * sql.DB
	constructor(db * sql.DB) { this.db = db }
	public func Create(ctx context.Context, item user.User) {
		try {
			this.db.ExecContext(ctx, "INSERT INTO users (id, name, email) VALUES (?, ?, ?)", item.Id(), item.Name(), item.Email())
		} catch err GoError {
			if constraintFailure(err.cause) { throw new user.ConflictError("user ID or email already exists") }
			throw err
		}
	}
	public func Update(ctx context.Context, item user.User) {
		try {
			result := this.db.ExecContext(ctx, "UPDATE users SET name = ?, email = ? WHERE id = ?", item.Name(), item.Email(), item.Id())
			if result.RowsAffected() == 0 { throw new user.NotFoundError(item.Id()) }
		} catch err GoError {
			if constraintFailure(err.cause) { throw new user.ConflictError("email already exists") }
			throw err
		}
	}
	public func Find(ctx context.Context, id string) user.User {
		var storedID string
		var name string
		var email string
		try {
			this.db.QueryRowContext(ctx, "SELECT id, name, email FROM users WHERE id = ?", id).Scan(& storedID, & name, & email)
		} catch err GoError {
			if errors.Is(err.cause, sql.ErrNoRows) { throw new user.NotFoundError(id) }
			throw err
		}
		return new user.User(storedID, name, email)
	}
	public func List(ctx context.Context) [] user.User {
		rows := this.db.QueryContext(ctx, "SELECT id, name, email FROM users ORDER BY rowid")
		defer rows.Close()
		items := [] user.User {}
		for rows.Next() {
			var id string
			var name string
			var email string
			rows.Scan(& id, & name, & email)
			items = append(items, new user.User(id, name, email))
		}
		rows.Err()
		return items
	}
	public func Delete(ctx context.Context, id string) {
		try {
			result := this.db.ExecContext(ctx, "DELETE FROM users WHERE id = ?", id)
			if result.RowsAffected() == 0 { throw new user.NotFoundError(id) }
		} catch err GoError {
			if constraintFailure(err.cause) { throw new user.ConflictError("user is assigned to tasks; unassign or delete those tasks first") }
			throw err
		}
	}
}
