namespace application.tasks

import context "go:context"
import uuid "go:github.com/google/uuid"
import task "domain.task"
import user "domain.user"

class Service {
	private repository task.Repository
	private users user.Repository

	constructor(repository task.Repository, users user.Repository) { this.repository = repository; this.users = users }
	private func ValidateAssignee(ctx context.Context, id string) {
		if id == "" { return }
		try { this.users.Find(ctx, id) } catch err user.NotFoundError {
			throw new task.ValidationError("assignee does not exist")
		}
	}

	public func Create(ctx context.Context, title string, assigneeID string = "") task.Task {
		this.ValidateAssignee(ctx, assigneeID)
		item := new task.Task(uuid.NewString(), title, false, assigneeID)
		this.repository.Create(ctx, item)
		return item
	}

	public func Replace(ctx context.Context, id string, title string, completed bool, assigneeID string = "") task.Task {
		item := this.repository.Find(ctx, id)
		this.ValidateAssignee(ctx, assigneeID)
		item.Rename(title)
		item.SetCompleted(completed)
		item.Assign(assigneeID)
		this.repository.Update(ctx, item)
		return item
	}

	public func Get(ctx context.Context, id string) task.Task { return this.repository.Find(ctx, id) }
	public func List(ctx context.Context) [] task.Task { return this.repository.List(ctx) }
	public func Delete(ctx context.Context, id string) { this.repository.Delete(ctx, id) }
}
