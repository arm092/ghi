namespace main

import application.tasks.Service as TaskService
import application.users.Service as UserService
import infrastructure.sqlite.Repository as SQLiteRepository
import presentation.httpapi
import http "go:net/http"
import os "go:os"
import signal "go:os/signal"
import syscall "go:syscall"
import context "go:context"
import errors "go:errors"
import time "go:time"
import slog "go:log/slog"
import infrastructure.config

func main() {
	slog.SetDefault(slog.New(slog.NewJSONHandler(os.Stdout, nil)))
	try { run() } catch err Exception { slog.Error("application_failed", "type", err.typeName, "code", err.code, "error", err.message); os.Exit(1) }
}

func run() {
	settings := config.Load(os.Getenv)
	level := slog.LevelInfo
	switch settings.LogLevel { case "debug": level = slog.LevelDebug; case "warn": level = slog.LevelWarn; case "error": level = slog.LevelError }
	logger := slog.New(slog.NewJSONHandler(os.Stdout, & slog.HandlerOptions { Level: level }))
	slog.SetDefault(logger)
	repository := new SQLiteRepository(settings.Database, settings.Migrations)
	defer repository.Close()
	userRepository := repository.Users()
	service := new TaskService(repository, userRepository)
	server := & http.Server { Addr: settings.Address, Handler: httpapi.NewRouter(service, new UserService(userRepository), logger, settings.RequestTimeout), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second, WriteTimeout: settings.RequestTimeout + 5 * time.Second, IdleTimeout: 60 * time.Second, ErrorLog: slog.NewLogLogger(logger.Handler(), slog.LevelError) }
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	shutdownDone := make(chan struct {})
	go func () {
		<- ctx.Done()
		deadline, cancel := context.WithTimeout(context.Background(), settings.ShutdownTimeout)
		defer cancel()
		try { server.Shutdown(deadline) } catch err GoError { logger.Error("shutdown_failed", "error", err.message) }
		close(shutdownDone)
	}()
	logger.Info("server_start", "address", settings.Address, "request_timeout", settings.RequestTimeout.String())
	try { server.ListenAndServe() } catch err GoError {
		if ! errors.Is(err.cause, http.ErrServerClosed) { stop(); <- shutdownDone; throw err }
	}
	stop()
	<- shutdownDone
}
