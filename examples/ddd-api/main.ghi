namespace main

import tasks "application.tasks"
import sqlite "infrastructure.sqlite"
import httpapi "presentation.httpapi"
import http "go:net/http"
import os "go:os"
import signal "go:os/signal"
import syscall "go:syscall"
import context "go:context"
import errors "go:errors"
import time "go:time"
import log "go:log"

func main() {
	path := os.Getenv("GHI_DDD_DB")
	if path == "" { path = "ddd-tasks.db" }
	address := os.Getenv("GHI_DDD_ADDR")
	if address == "" { address = "127.0.0.1:8081" }
	repository := new sqlite.Repository(path)
	defer repository.Close()
	service := new tasks.Service(repository)
	server := & http.Server { Addr: address, Handler: httpapi.NewRouter(service), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second, WriteTimeout: 20 * time.Second, IdleTimeout: 60 * time.Second }
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	shutdownDone := make(chan struct {})
	go func () {
		<- ctx.Done()
		deadline, cancel := context.WithTimeout(context.Background(), 5 * time.Second)
		defer cancel()
		try { server.Shutdown(deadline) } catch err GoError { log.Printf("shutdown: %s", err.message) }
		close(shutdownDone)
	}()
	log.Printf("Ghi DDD Task API listening on http://%s", address)
	try { server.ListenAndServe() } catch err GoError {
		if ! errors.Is(err.cause, http.ErrServerClosed) { stop(); <- shutdownDone; throw err }
	}
	stop()
	<- shutdownDone
}
