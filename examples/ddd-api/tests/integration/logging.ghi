namespace tests.integration
import application.tasks
import application.users
import bytes "go:bytes"
import json "go:encoding/json"
import slog "go:log/slog"
import httptest "go:net/http/httptest"
import filepath "go:path/filepath"
import testing "go:testing"
import infrastructure.sqlite
import presentation.httpapi

func TestStructuredRequestLog(t *testing.T) {
	repository := new sqlite.Repository(filepath.Join(t.TempDir(), "logging.db"))
	defer repository.Close()
	var output bytes.Buffer
	logger := slog.New(slog.NewJSONHandler(&output, nil))
	router := httpapi.NewRouter(new tasks.Service(repository, repository.Users()), new users.Service(repository.Users()), logger)
	request := httptest.NewRequest("GET", "/health", nil)
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	var record struct {
		Msg string
		Method string
		Path string
		Status int
		RequestID string `json:"request_id"`
	}
	json.NewDecoder(&output).Decode(&record)
	if record.Msg != "http_request" || record.Method != "GET" || record.Path != "/health" || record.Status != 200 || record.RequestID == "" {
		t.Fatalf("missing structured request fields: %#v", record)
	}
}
