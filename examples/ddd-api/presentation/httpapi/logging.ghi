namespace presentation.httpapi
import middleware "go:github.com/go-chi/chi/v5/middleware"
import slog "go:log/slog"
import http "go:net/http"
import time "go:time"

func requestLog(logger *slog.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			started := time.Now()
			response := middleware.NewWrapResponseWriter(w, r.ProtoMajor)
			defer func() {
				status := response.Status()
				if status == 0 {
					status = 200
				}
				logger.Info("http_request", "method", r.Method, "path", r.URL.Path, "status", status, "duration_ms", time.Since(started).Milliseconds(), "request_id", middleware.GetReqID(r.Context()))
			}()
			next.ServeHTTP(response, r)
		})
	}
}
