<idea-plugin>
    <id>am.ghi.language</id>
    <name>Ghi</name>
    <vendor url="https://github.com/arm092/ghi">Arman Khachatryan</vendor>
    <description><![CDATA[
        Ghi (Go, Hierarchy, Interfaces) support for GoLand.
        Recognizes .ghi files, highlights syntax, supports comments and brace matching,
        and builds or runs projects in the IDE console with clickable compiler diagnostics.
        Configure the compiler and project directory under Languages &amp; Frameworks &gt; Ghi.
        Requires the Ghi compiler. Includes Ghi declaration navigation, completion, parameter information, symbol rename and saved-file compiler diagnostics. Go symbol resolution and debugging are not included.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.go</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Ghi" language="Ghi" implementationClass="am.ghi.ide.GhiFileType" fieldName="INSTANCE" extensions="ghi"/>
        <lang.parserDefinition language="Ghi" implementationClass="am.ghi.ide.GhiParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Ghi" implementationClass="am.ghi.ide.GhiHighlighterFactory"/>
        <completion.contributor language="Ghi" implementationClass="am.ghi.ide.GhiCompletion"/>
        <lang.parameterInfo language="Ghi" implementationClass="am.ghi.ide.GhiParameterInfo"/>
        <lang.findUsagesProvider language="Ghi" implementationClass="am.ghi.ide.GhiFindUsages"/>
        <renamePsiElementProcessor implementation="am.ghi.ide.GhiRenameProcessor"/>
        <externalAnnotator language="Ghi" implementationClass="am.ghi.ide.GhiExternalAnnotator"/>
        <lang.commenter language="Ghi" implementationClass="am.ghi.ide.GhiCommenter"/>
        <lang.braceMatcher language="Ghi" implementationClass="am.ghi.ide.GhiBraceMatcher"/>
        <colorSettingsPage implementation="am.ghi.ide.GhiColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colors/GhiDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colors/GhiDarcula.xml"/>
        <projectService serviceImplementation="am.ghi.ide.GhiSettings"/>
        <projectConfigurable parentId="language" id="am.ghi.settings" displayName="Ghi" instance="am.ghi.ide.GhiConfigurable"/>
    </extensions>
    <actions>
        <group id="Ghi.Tools" text="Ghi" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Ghi.Build" class="am.ghi.ide.GhiAction$Build" text="Build Project" description="Compile the Ghi project to a native executable"/>
            <action id="Ghi.Run" class="am.ghi.ide.GhiAction$Run" text="Run Project" description="Build and run the Ghi project"/>
        </group>
    </actions>
</idea-plugin>
