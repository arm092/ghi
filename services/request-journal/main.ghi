namespace main

import context "go:context"
import errors "go:errors"
import slog "go:log/slog"
import net "go:net"
import http "go:net/http"
import os "go:os"
import signal "go:os/signal"
import syscall "go:syscall"
import time "go:time"
import journal.application.AuthService
import journal.application.Service
import journal.config
import journal.httpapi
import journal.storage.AuthRepository
import journal.storage.Repository

func run() {
	settings := config.Load()
	repository := new Repository(settings.Database, settings.Migrations, settings.Driver)
	defer repository.Close()
	server := &http.Server{
		Handler: httpapi.Router(new Service(repository), new AuthService(new AuthRepository(repository.Database()), settings.SessionTTL)),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout: 10 * time.Second,
		WriteTimeout: 10 * time.Second,
		IdleTimeout: 60 * time.Second,
	}
	listener := net.Listen("tcp", settings.Address)
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	done := make(chan struct{})
	go func() {
		<-ctx.Done()
		deadline, cancel := context.WithTimeout(context.Background(), settings.ShutdownTimeout)
		defer cancel()
		try {
			server.Shutdown(deadline)
		} catch err GoError {
			slog.Error("shutdown_failed", "error", err.message)
			server.Close()
		}
		close(done)
	}()
	slog.Info("listening", "address", listener.Addr().String())
	try {
		server.Serve(listener)
	} catch err GoError {
		if !errors.Is(err.cause, http.ErrServerClosed) {
			stop()
			<-done
			throw err
		}
	}
	stop()
	<-done
}

func main() {
	slog.SetDefault(slog.New(slog.NewJSONHandler(os.Stdout, nil)))
	try {
		run()
	} catch err Exception {
		slog.Error("startup_failed", "error", err.message)
		os.Exit(1)
	}
}
