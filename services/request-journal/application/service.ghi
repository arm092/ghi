namespace journal.application

import arm092.validation.Validator
import context "go:context"
import math "go:math"
import strings "go:strings"
import journal.domain
import journal.storage.Repository

func title(check Validator, value string) string {
	value = strings.TrimSpace(value)
	check.RequiredText("title", value)
	check.TextLength("title", value, 1, 200)
	if strings.ContainsRune(value, 0) {
		check.Reject("title", "nul_character")
	}

	return value
}

func validateStatus(check Validator, value string) {
	check.OneOf("status", value, []string{
		domain.Status.Open,
		domain.Status.InProgress,
		domain.Status.Resolved,
	})
}

func requireValid(check Validator) {
	if !check.Valid() {
		failure := new domain.InvalidInput("invalid request fields")
		for _, violation := range check.Errors() {
			failure.violations = append(failure.violations, domain.FieldViolation{
				Field: violation.Field(),
				Code: violation.Code(),
			})
		}
		throw failure
	}
}

class Service {
	private repository Repository

	constructor(repository Repository) {
		this.repository = repository
	}

	public func Health(ctx context.Context) {
		this.repository.Ping(ctx)
	}

	public func Create(ctx context.Context, value string, status string = "") domain.Request {
		check := new Validator()
		value = title(check, value)
		if status != "" {
			check.Reject("status", "initial_status")
		}
		requireValid(check)

		return this.repository.Create(ctx, value)
	}

	public func Get(ctx context.Context, id int64) domain.Request {
		return this.repository.Get(ctx, id)
	}

	public func List(ctx context.Context, status string, limit int, offset int) []domain.Request {
		check := new Validator()
		if status != "" {
			validateStatus(check, status)
		}
		check.IntRange("limit", limit, 1, 100)
		check.IntRange("offset", offset, 0, math.MaxInt)
		requireValid(check)

		return this.repository.List(ctx, status, limit, offset)
	}

	public func Update(ctx context.Context, id int64, value string, status string) domain.Request {
		check := new Validator()
		value = title(check, value)
		validateStatus(check, status)
		requireValid(check)

		return this.repository.Update(ctx, id, value, status)
	}

	public func Delete(ctx context.Context, id int64) {
		this.repository.Delete(ctx, id)
	}

	public func History(ctx context.Context, id int64) []domain.Event {
		return this.repository.History(ctx, id)
	}
}
