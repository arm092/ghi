namespace journal.httpapi

import context "go:context"
import json "go:encoding/json"
import chi "go:github.com/go-chi/chi/v5"
import io "go:io"
import slog "go:log/slog"
import http "go:net/http"
import strconv "go:strconv"
import strings "go:strings"
import time "go:time"
import journal.application.AuthService
import journal.application.Service
import journal.domain

type Input struct {
	Title string `json:"title"`
	Status string `json:"status"`
}

class BadRequest extends Exception {
	constructor() {
		parent("expected a single JSON object with known fields", 400)
	}
}

func decode(w http.ResponseWriter, r *http.Request) Input {
	r.Body = http.MaxBytesReader(w, r.Body, 4096)
	var input Input
	try {
		decoder := json.NewDecoder(r.Body)
		decoder.DisallowUnknownFields()
		decoder.Decode(&input)
		var trailing any
		try {
			decoder.Decode(&trailing)
		} catch err GoError {
			if err.cause == io.EOF {
				return input
			}
			throw err
		}
	} catch err GoError {
		throw new BadRequest()
	}
	throw new BadRequest()
}

func send(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(body)
}

// Consume small rejected bodies before replying. Closing a Windows socket with
// unread request data can reset the connection before the response is received.
func discardBody(w http.ResponseWriter, r *http.Request) {
	try {
		io.Copy(io.Discard, http.MaxBytesReader(w, r.Body, 4096))
	} catch err GoError {
		// Oversized or interrupted bodies are already bounded by MaxBytesReader.
	}
}

func guard(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Cache-Control", "no-store")
		ctx, cancel := context.WithTimeout(r.Context(), 5 * time.Second)
		defer cancel()
		try {
			next(w, r.WithContext(ctx))
		} catch err domain.Unauthorized {
			discardBody(w, r)
			w.Header().Set("WWW-Authenticate", "Bearer")
			send(w, 401, map[string]string{
				"error": err.message,
			})
		} catch err domain.Conflict {
			send(w, 409, map[string]string{
				"error": err.message,
			})
		} catch err domain.TooManyRequests {
			w.Header().Set("Retry-After", "60")
			send(w, 429, map[string]string{
				"error": err.message,
			})
		} catch err BadRequest {
			send(w, 400, map[string]string{
				"error": err.message,
			})
		} catch err domain.InvalidInput {
			send(w, 422, map[string]any{
				"error": err.message,
				"fields": err.violations,
			})
		} catch err domain.NotFound {
			send(w, 404, map[string]string{
				"error": err.message,
			})
		} catch err Exception {
			slog.Error("request_failed", "method", r.Method, "path", r.URL.Path, "error", err.message)
			send(w, 500, map[string]string{
				"error": "internal server error",
			})
		}
	}
}

func invalid(field string, code string, message string) domain.InvalidInput {
	failure := new domain.InvalidInput(message)
	failure.violations = append(failure.violations, domain.FieldViolation{
		Field: field,
		Code: code,
	})

	return failure
}

func id(r *http.Request) int64 {
	value := int64(0)
	try {
		value = strconv.ParseInt(chi.URLParam(r, "id"), 10, 64)
	} catch err GoError {
		throw invalid("id", "positive_integer", "id must be a positive integer")
	}
	if value < 1 {
		throw invalid("id", "positive_integer", "id must be a positive integer")
	}

	return value
}

func number(value string, fallback int, field string) int {
	if value == "" {
		return fallback
	}
	try {
		return strconv.Atoi(value)
	} catch err GoError {
		throw invalid(field, "integer", "pagination parameters must be integers")
	}
}

func Router(service Service, auth AuthService) http.Handler {
	router := chi.NewRouter()
	limiter := new AuthLimiter()
	router.Post("/auth/register", guard(func(w http.ResponseWriter, r *http.Request) {
		input := decodeCredentials(w, r)
		limiter.Check(r)
		send(w, 201, auth.Register(r.Context(), input.Email, input.Password))
	}))
	router.Post("/auth/login", guard(func(w http.ResponseWriter, r *http.Request) {
		input := decodeCredentials(w, r)
		limiter.Check(r)
		send(w, 200, auth.Login(r.Context(), input.Email, input.Password))
	}))
	router.Get("/me", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		send(w, 200, auth.Authenticate(r.Context(), bearer(r)))
	}))
	router.Post("/auth/logout", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		discardBody(w, r)
		auth.Logout(r.Context(), bearer(r))
		w.WriteHeader(204)
	}))
	router.NotFound(func(w http.ResponseWriter, r *http.Request) {
		discardBody(w, r)
		send(w, 404, map[string]string{
			"error": "route not found",
		})
	})
	router.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
		discardBody(w, r)
		allowed := []string{}
		for _, method := range []string{
			"GET",
			"POST",
			"PUT",
			"DELETE",
		} {
			if router.Match(chi.NewRouteContext(), method, r.URL.Path) {
				allowed = append(allowed, method)
			}
		}
		w.Header().Set("Allow", strings.Join(allowed, ", "))
		send(w, 405, map[string]string{
			"error": "method not allowed",
		})
	})
	router.Get("/health", guard(func(w http.ResponseWriter, r *http.Request) {
		service.Health(r.Context())
		send(w, 200, map[string]string{
			"status": "ok",
		})
	}))
	router.Get("/requests", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		query := r.URL.Query()
		send(w, 200, service.List(r.Context(), query.Get("status"), number(query.Get("limit"), 20, "limit"), number(query.Get("offset"), 0, "offset")))
	}))
	router.Post("/requests", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		input := decode(w, r)
		item := service.Create(r.Context(), input.Title, input.Status)
		w.Header().Set("Location", "/requests/" + strconv.FormatInt(item.ID, 10))
		send(w, 201, item)
	}))
	router.Get("/requests/{id}", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		send(w, 200, service.Get(r.Context(), id(r)))
	}))
	router.Put("/requests/{id}", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		input := decode(w, r)
		send(w, 200, service.Update(r.Context(), id(r), input.Title, input.Status))
	}))
	router.Delete("/requests/{id}", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		service.Delete(r.Context(), id(r))
		w.WriteHeader(204)
	}))
	router.Get("/requests/{id}/history", secured(auth, func(w http.ResponseWriter, r *http.Request) {
		send(w, 200, service.History(r.Context(), id(r)))
	}))

	return router
}
