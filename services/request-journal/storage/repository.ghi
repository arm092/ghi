namespace journal.storage

import arm092.migrations.Migrator
import context "go:context"
import sql "go:database/sql"
import errors "go:errors"
import _ "go:github.com/jackc/pgx/v5/stdlib"
import _ "go:modernc.org/sqlite"
import url "go:net/url"
import filepath "go:path/filepath"
import strings "go:strings"
import time "go:time"
import journal.domain

func rollback(tx *sql.Tx) {
	try {
		tx.Rollback()
	} catch err GoError {
		if !errors.Is(err.cause, sql.ErrTxDone) {
			throw err
		}
	}
}

class Repository {
	private db * sql.DB
	private postgres bool

	constructor(path string, directory string, driver string = "sqlite") {
		if driver != "sqlite" && driver != "postgres" {
			throw new Exception("unsupported database driver")
		}
		this.postgres = driver == "postgres"
		if this.postgres {
			this.db = sql.Open("pgx", path)
			this.db.SetMaxOpenConns(10)
			this.db.SetMaxIdleConns(10)
			this.db.SetConnMaxLifetime(30 * time.Minute)
			directory = filepath.Join(directory, "postgres")
		} else {
			connection := url.URL{
				Scheme: "file",
				Path: "/" + strings.TrimPrefix(filepath.ToSlash(filepath.Abs(path)), "/"),
				RawQuery: "_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)",
			}
			this.db = sql.Open("sqlite", connection.String())
			this.db.SetMaxOpenConns(1)
		}
		try {
			ctx, cancel := context.WithTimeout(context.Background(), 5 * time.Second)
			defer cancel()
			this.db.PingContext(ctx)
			if !this.postgres {
				this.db.Exec("PRAGMA journal_mode = WAL")
			}
			migrator := new Migrator(this.db, directory, driver)
			migrator.Up()
		} catch err Exception {
			this.db.Close()
			throw err
		}
	}

	public func Database() *sql.DB {
		return this.db
	}

	public func Close() {
		this.db.Close()
	}

	public func Ping(ctx context.Context) {
		this.db.PingContext(ctx)
	}

	public func Create(ctx context.Context, title string) domain.Request {
		tx := this.db.BeginTx(ctx, nil)
		defer rollback(tx)
		now := time.Now().UTC().Format(time.RFC3339Nano)
		id := int64(0)
		tx.QueryRowContext(ctx, "INSERT INTO requests(title, status, created_at, updated_at,user_id) VALUES ($1,$2,$3,$4,$5) RETURNING id", title, domain.Status.Open, now, now, domain.UserID(ctx)).Scan(&id)
		tx.ExecContext(ctx, "INSERT INTO request_events(request_id, status, created_at) VALUES ($1,$2,$3)", id, domain.Status.Open, now)
		tx.Commit()

		return domain.Request{
			ID: id,
			Title: title,
			Status: domain.Status.Open,
			CreatedAt: now,
			UpdatedAt: now,
		}
	}

	public func Get(ctx context.Context, id int64) domain.Request {
		rows := this.db.QueryContext(ctx, "SELECT id, title, status, created_at, updated_at FROM requests WHERE id = $1 AND user_id=$2", id, domain.UserID(ctx))
		defer rows.Close()
		if !rows.Next() {
			rows.Err()
			throw new domain.NotFound()
		}
		var item domain.Request
		rows.Scan(&item.ID, &item.Title, &item.Status, &item.CreatedAt, &item.UpdatedAt)

		return item
	}

	public func List(ctx context.Context, status string, limit int, offset int) []domain.Request {
		rows := this.db.QueryContext(ctx, "SELECT id, title, status, created_at, updated_at FROM requests WHERE user_id=$1 AND ($2 = '' OR status=$2) ORDER BY id DESC LIMIT $3 OFFSET $4", domain.UserID(ctx), status, limit, offset)
		defer rows.Close()
		items := []domain.Request{}
		for rows.Next() {
			var item domain.Request
			rows.Scan(&item.ID, &item.Title, &item.Status, &item.CreatedAt, &item.UpdatedAt)
			items = append(items, item)
		}
		rows.Err()

		return items
	}

	public func Update(ctx context.Context, id int64, title string, status string) domain.Request {
		tx := this.db.BeginTx(ctx, nil)
		defer rollback(tx)
		var item domain.Request
		lock := this.postgres ? " FOR UPDATE" : ""
		try {
			tx.QueryRowContext(ctx, "SELECT id, title, status, created_at, updated_at FROM requests WHERE id = $1 AND user_id=$2" + lock, id, domain.UserID(ctx)).Scan(&item.ID, &item.Title, &item.Status, &item.CreatedAt, &item.UpdatedAt)
		} catch err GoError {
			if errors.Is(err.cause, sql.ErrNoRows) {
				throw new domain.NotFound()
			}
			throw err
		}
		item.Title = title
		item.UpdatedAt = time.Now().UTC().Format(time.RFC3339Nano)
		tx.ExecContext(ctx, "UPDATE requests SET title=$1,status=$2,updated_at=$3 WHERE id=$4 AND user_id=$5", title, status, item.UpdatedAt, id, domain.UserID(ctx))
		if item.Status != status {
			tx.ExecContext(ctx, "INSERT INTO request_events(request_id, status, created_at) VALUES ($1,$2,$3)", id, status, item.UpdatedAt)
		}
		item.Status = status
		tx.Commit()

		return item
	}

	public func Delete(ctx context.Context, id int64) {
		result := this.db.ExecContext(ctx, "DELETE FROM requests WHERE id = $1 AND user_id=$2", id, domain.UserID(ctx))
		if result.RowsAffected() == 0 {
			throw new domain.NotFound()
		}
	}

	public func History(ctx context.Context, id int64) []domain.Event {
		this.Get(ctx, id)
		rows := this.db.QueryContext(ctx, "SELECT id, status, created_at FROM request_events WHERE request_id=$1 AND EXISTS (SELECT 1 FROM requests WHERE id=$1 AND user_id=$2) ORDER BY id", id, domain.UserID(ctx))
		defer rows.Close()
		events := []domain.Event{}
		for rows.Next() {
			var event domain.Event
			rows.Scan(&event.ID, &event.Status, &event.CreatedAt)
			events = append(events, event)
		}
		rows.Err()

		return events
	}
}
